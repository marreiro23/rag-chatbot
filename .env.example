# Optional: use a named Cloudflare Tunnel instead of an ephemeral Quick Tunnel.
# Generate this token in the Cloudflare Zero Trust dashboard.
CLOUDFLARE_TUNNEL_TOKEN=

# ======================
# Configuração do Python
# ======================

# Versão mínima de Python (padrão: 3.9)
# MIN_PYTHON_VERSION=3.9

# ======================
# Armazenamento Remoto
# ======================

# Tipo de armazenamento remoto
# Valores: none, gdrive, dropbox, s3, gcp, azure, r2
REMOTE_STORAGE_BACKEND=none

# Nome do remote configurado no rclone
# Exemplos: aws-s3, gdrive, dropbox-personal, gcp-gcs, azure-sa, cf-r2
REMOTE_STORAGE_NAME=

# Caminho dentro do remote (ex: bucket/prefixo ou pasta)
# Exemplos: meu-bucket/rag-data, /rag-chatbot/dados
REMOTE_STORAGE_PATH=

# Modo de montagem
# Valores: host (rclone mount no host), volume (Docker volume plugin)
REMOTE_MOUNT_MODE=host

# Diretório onde montar o remote no host (apenas para REMOTE_MOUNT_MODE=host)
# Padrão: /mnt/remote-storage
REMOTE_HOST_MOUNT_DIR=/mnt/remote-storage

# ======================
# Exemplo AWS S3
# ======================
# REMOTE_STORAGE_BACKEND=s3
# REMOTE_STORAGE_NAME=aws-s3
# REMOTE_STORAGE_PATH=meu-bucket/rag-chatbot
# REMOTE_MOUNT_MODE=host

# ======================
# Exemplo Google Drive
# ======================
# REMOTE_STORAGE_BACKEND=gdrive
# REMOTE_STORAGE_NAME=gdrive
# REMOTE_STORAGE_PATH=rag-chatbot/dados
# REMOTE_MOUNT_MODE=host

# ======================
# Exemplo Cloudflare R2
# ======================
# REMOTE_STORAGE_BACKEND=r2
# REMOTE_STORAGE_NAME=cf-r2
# REMOTE_STORAGE_PATH=meu-bucket-r2/rag-data
# REMOTE_MOUNT_MODE=host

# ======================
# Exemplo Docker Volume Plugin
# ======================
# REMOTE_STORAGE_BACKEND=s3
# REMOTE_STORAGE_NAME=aws-s3
# REMOTE_STORAGE_PATH=meu-bucket/rag-chatbot
# REMOTE_MOUNT_MODE=volume
