# .envrc - Arquivo de configuração do direnv
# Use: https://direnv.net
# Instale com: apt install direnv (Linux) ou brew install direnv (macOS)
#
# Para ativar:
# 1. Instale direnv
# 2. Configure seu shell (veja https://direnv.net/docs/installation.html)
# 3. Execute: direnv allow
#
# Depois que sair e voltar para esta pasta, o ambiente será carregado automaticamente!

# Carrega as variáveis do arquivo .env se existir
if [ -f .env ]; then
  dotenv .env
fi

# Carrega o arquivo de ambiente do projeto
if [ -f scripts/env.sh ]; then
  source scripts/env.sh
fi

# Define variáveis padrão se não estiverem definidas
: ${REMOTE_STORAGE_BACKEND:=none}
: ${REMOTE_MOUNT_MODE:=host}
: ${REMOTE_HOST_MOUNT_DIR:=/mnt/remote-storage}

export REMOTE_STORAGE_BACKEND
export REMOTE_MOUNT_MODE
export REMOTE_HOST_MOUNT_DIR

echo "[direnv] Ambiente do RAG Chatbot carregado!"
